{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Pages: the prerendered site in build/client, plus the
  // functions in functions/ (locale redirect, Markdown for LLMs, feedback API).
  "name": "nino",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "build/client",
  // With this file present, Pages ignores the dashboard's text variables, so
  // the build's Bun version is set here: the build image's default (1.2.15)
  // cannot read the version 2 bun.lock. Keep it at the Bun version used locally.
  "vars": {
    "BUN_VERSION": "1.4.2"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers static assets: no Worker script, only the files in
  // build/client. Unknown paths get build/client/404.html with a 404 status.
  // Page URLs have no trailing slash (/en/docs/v4/start serves start/index.html).
  "name": "nino",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./build/client",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}

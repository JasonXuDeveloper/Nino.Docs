    {
      "id": "references",
      "spec": "A.5",
      "en": {
        "title": "Reference tracking",
        "note": "A tracked object is written once, after a reference header; every later slot that holds it, another member or its own Next (a cycle), writes only its number."
      },
      "zh": {
        "title": "引用追踪",
        "note": "追踪的对象只写一次，紧跟在引用头之后；之后再持有它的槽位（另一个成员，或它自己的 Next，即循环）只写它的编号。"
      },
      "code": "[NinoType(trackReferences: true)]\npublic sealed class Node\n{\n    public int V;\n    public Node Next;\n}\n\n[NinoType]\npublic sealed class Holder\n{\n    public object Any;\n    public Node N;\n}\n\nvar n = new Node { V = 5 };\nn.Next = n;\nnew Holder { Any = n, N = n }",
      "rows": [
        {
          "en": "new Holder { Any = n, N = n }",
          "zh": "new Holder { Any = n, N = n }",
          "fields": [
            {
              "hex": "01",
              "kind": "header",
              "en": "Holder presence byte",
              "zh": "Holder 的存在字节"
            },
            {
              "hex": "06 2E 6C 29",
              "kind": "id",
              "en": "Any: type id of Spec.Node",
              "zh": "Any：Spec.Node 的类型 ID"
            },
            {
              "hex": "FF FF FF FF",
              "kind": "header",
              "en": "reference header: new object #1",
              "zh": "引用头：新对象 #1"
            },
            {
              "hex": "05 00 00 00",
              "kind": "value",
              "en": "V = 5",
              "zh": "V = 5"
            },
            {
              "hex": "01 00 00 00",
              "kind": "changed",
              "en": "Next: object #1 again (the cycle)",
              "zh": "Next：再次指向对象 #1（循环）"
            },
            {
              "hex": "01 00 00 00",
              "kind": "changed",
              "en": "N: object #1 again",
              "zh": "N：再次指向对象 #1"
            }
          ]
        }
      ]
    },
    {
      "id": "raw",
      "spec": "A.6",
      "en": {
        "title": "Raw structs",
        "note": "An unmanaged struct is written as its memory, padding zeroed; an array of them is a count and one block copy."
      },
      "zh": {
        "title": "原始结构体",
        "note": "非托管结构体按内存原样写入，填充字节清零；它的数组是数量加一次整块拷贝。"
      },
      "code": "[NinoType]\npublic struct RawPoint\n{\n    public int X;\n    public byte Y;\n}\n\nnew RawPoint[] { new() { X = 1, Y = 2 }, new() { X = 3, Y = 4 } }",
      "rows": [
        {
          "en": "RawPoint { X = 1, Y = 2 }",
          "zh": "RawPoint { X = 1, Y = 2 }",
          "fields": [
            {
              "hex": "01 00 00 00",
              "kind": "value",
              "en": "X = 1",
              "zh": "X = 1"
            },
            { "hex": "02", "kind": "value", "en": "Y = 2", "zh": "Y = 2" },
            {
              "hex": "00 00 00",
              "kind": "pad",
              "en": "padding, zeroed",
              "zh": "填充，清零"
            }
          ]
        },

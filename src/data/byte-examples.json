    {
      "id": "version-tolerant",
      "spec": "A.3",
      "en": {
        "title": "Version-tolerant",
        "note": "One length for the whole hierarchy, so an older reader skips the members it does not know. Declared as the base, the value starts with its type id instead of a presence byte."
      },
      "zh": {
        "title": "版本容错",
        "note": "整个继承体系只写一个长度，旧的读取方可以跳过它不认识的成员。声明为基类时，值以类型 ID 开头，而不是存在字节。"
      },
      "code": "[NinoType(format: NinoFormat.VersionTolerant)]\npublic class TolBase { public int A; }\n\n[NinoType(format: NinoFormat.VersionTolerant)]\npublic sealed class TolLeaf : TolBase { public int B; }\n\nnew TolLeaf { A = 1, B = 7 }",
      "rows": [
        {
          "en": "as TolLeaf",
          "zh": "声明为 TolLeaf",
          "fields": [
            {
              "hex": "01",
              "kind": "header",
              "en": "presence byte",
              "zh": "存在字节"
            },
            {
              "hex": "08 00 00 00",
              "kind": "length",
              "en": "body length 8",
              "zh": "主体长度 8"
            },
            {
              "hex": "01 00 00 00",
              "kind": "value",
              "en": "A = 1",
              "zh": "A = 1"
            },
            {
              "hex": "07 00 00 00",
              "kind": "changed",
              "en": "B = 7 (skipped by a TolBase-only reader)",
              "zh": "B = 7（只认识 TolBase 的读取方跳过它）"
            }
          ]
        },
        {
          "en": "as TolBase",
          "zh": "声明为 TolBase",
          "fields": [
            {
              "hex": "77 30 46 2B",
              "kind": "id",
              "en": "type id of Spec.TolLeaf",
              "zh": "Spec.TolLeaf 的类型 ID"
            },
            {
              "hex": "08 00 00 00",
              "kind": "length",
              "en": "body length 8",
              "zh": "主体长度 8"
            },
            {
              "hex": "01 00 00 00",
              "kind": "value",
              "en": "A = 1",
              "zh": "A = 1"
            },
            {
              "hex": "07 00 00 00",
              "kind": "changed",
              "en": "B = 7",
              "zh": "B = 7"
            }
          ]
        }
      ]
    },
    {
      "id": "strings",
      "spec": "A.4",
      "en": {
        "title": "Strings",
        "note": "The default encoding writes text whose chars are all at most U+00FF in one byte a char, other text as UTF-16; [NinoUtf8] writes UTF-8 with a byte count. The header's first byte gives its size."
      },
      "zh": {
        "title": "字符串",
        "note": "默认编码下，所有字符都不超过 U+00FF 的文本每个字符一个字节，其他文本按 UTF-16 写；[NinoUtf8] 按 UTF-8 写，并带字节数。头的第一个字节给出头的大小。"
      },
      "code": "[NinoType]\npublic sealed class Strings\n{\n    public string Def;\n    [NinoUtf8] public string U8;\n}",
      "strings": [

              "hex": "01 00 00 00 02 00 00 00",
              "kind": "value",
              "en": "(1, 2)",
              "zh": "(1, 2)"
            },
            {
              "hex": "03 00 00 00 04 00 00 00",
              "kind": "value",
              "en": "(3, 4)",
              "zh": "(3, 4)"
            }
          ]
        }

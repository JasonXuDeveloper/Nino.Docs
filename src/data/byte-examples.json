{
  "source": "Nino's docs/spec/wire-format.md, Appendix A: dumps of a real run of Nino 4.0.0-rc.8 (net10.0, x64). bun run check:bytes checks every row against it.",
  "examples": [
    {
      "id": "small",
      "spec": "A.1",
      "en": {
        "title": "A small type",
        "note": "A sealed class: a presence byte, then its members in declaration order, with no names or lengths."
      },
      "zh": {
        "title": "一个小类型",
        "note": "密封类：先是存在字节，再按声明顺序写成员，不带名称和长度。"
      },
      "code": "[NinoType]\npublic sealed class Small\n{\n    public int A;\n    public string B;\n}\n\nnew Small { A = 1, B = \"a\" }",
      "rows": [
        {
          "en": "new Small { A = 1, B = \"a\" }",
          "zh": "new Small { A = 1, B = \"a\" }",
          "fields": [
            {
              "hex": "01",
              "kind": "header",
              "en": "presence byte",
              "zh": "存在字节"
            },
            {
              "hex": "01 00 00 00",
              "kind": "value",
              "en": "A = 1",
              "zh": "A = 1"
            },
            {
              "hex": "03 61",
              "kind": "value",
              "en": "B = \"a\" (header 3: one Latin-1 char)",
              "zh": "B = \"a\"（头 3：一个 Latin-1 字符）"
            }
          ]
        },
        {
          "en": "null",
          "zh": "null",
          "fields": [
            {
              "hex": "00",
              "kind": "header",
              "en": "presence byte: null",
              "zh": "存在字节：null"
            }
          ]
        }
      ]
    },
    {
      "id": "polymorphism",
      "spec": "A.2",
      "en": {
        "title": "Polymorphism",
        "note": "Each element declared as the abstract base starts with the type id of its runtime type; null is four zero bytes."
      },
      "zh": {
        "title": "多态",
        "note": "声明为抽象基类的每个元素都以运行时类型的类型 ID 开头；null 写成四个 0 字节。"
      },
      "code": "[NinoType]\npublic abstract class Shape { public int Id; }\n\n[NinoType]\npublic sealed class Circle : Shape { public float R; }\n\n[NinoType]\npublic sealed class Square : Shape { public float Side; }\n\nnew List<Shape>\n{\n    new Circle { Id = 1, R = 1f },\n    new Square { Id = 2, Side = 2f },\n    null,\n}",
      "rows": [
        {
          "en": "List<Shape>",
          "zh": "List<Shape>",
          "fields": [
            {
              "hex": "03 00 00 00",
              "kind": "length",
              "en": "count 3",
              "zh": "数量 3"
            },
            {
              "hex": "AC 2B C0 ED",
              "kind": "id",
              "en": "type id of Spec.Circle",
              "zh": "Spec.Circle 的类型 ID"
            },
            {
              "hex": "01 00 00 00",
              "kind": "value",
              "en": "Id = 1 (the base's member first)",
              "zh": "Id = 1（基类的成员在前）"
            },
            {
              "hex": "00 00 80 3F",
              "kind": "value",
              "en": "R = 1f",
              "zh": "R = 1f"
            },
            {
              "hex": "1F 27 E7 8F",
              "kind": "id",
              "en": "type id of Spec.Square",
              "zh": "Spec.Square 的类型 ID"
            },
            {
              "hex": "02 00 00 00",
              "kind": "value",
              "en": "Id = 2",
              "zh": "Id = 2"
            },
            {
              "hex": "00 00 00 40",
              "kind": "value",
              "en": "Side = 2f",
              "zh": "Side = 2f"
            },
            { "hex": "00 00 00 00", "kind": "id", "en": "null", "zh": "null" }
          ]
        }
      ]
    },
    {
      "id": "keyed",
      "spec": "A.3",
      "en": {
        "title": "Keyed",
        "note": "A body length, then one entry per member: the FNV-1a hash of its name, its length and its value. Entries may come in any order, so members can be reordered, removed or inserted."
      },
      "zh": {
        "title": "键控",
        "note": "先是主体长度，再为每个成员写一项：成员名的 FNV-1a 哈希、长度和值。各项顺序任意，所以成员可以重排、删除或插入。"
      },
      "code": "[NinoType(format: NinoFormat.Keyed)]\npublic sealed class Keyed\n{\n    public int Id;\n    [NinoFormerName(\"Title\")] public string Name;\n    public long Score;\n}\n\nnew Keyed { Id = 1, Name = \"n\", Score = 2 }",
      "rows": [
        {
